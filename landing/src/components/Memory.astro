---
// Memory: the copy, and the Memory screen in miniature.
// Facts as the Memory screen lists them: grouped by day, [when, fact, pills].
const facts = [
  { label: 'Today', rows: [
    ['14:32', 'Mara answers fastest on Telegram', ['preference', 'violet']],
    ['09:10', 'The café chain reorders every six weeks', ['Shared']],
  ] },
  { label: 'This week', rows: [
    ['Sep 30', 'Never discount the mug set below €39', ['reviewed', 'emerald']],
    ['Sep 29', 'Investor calls are on Thursdays', null],
  ] },
];
---
<section id="memory">
  <div class="wrap mem">
    <div class="mem-copy fade-up">
      <h2 class="mem-title">Context that outlasts the chat.</h2>
      <p class="lead">Close the chat and nothing is lost. Your coworker keeps what they learn about people, rules and decisions, and brings it back the next time it matters.</p>
    </div>

    <div class="mv fade-up" aria-hidden="true">
      <div class="mv-head">
        <svg class="mv-brain" viewBox="0 0 24 24"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/><path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"/></svg>
        <span class="mv-title">Memory</span>
        <span class="mv-search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>Ask what I remember…</span>
      </div>
      <div class="mv-body">
        <div class="mv-tabs"><span class="on">Facts <i>24</i></span><span>Topics <i>6</i></span></div>
        <div class="mv-list">
          {facts.map((g) => (
            <>
              <div class="mv-group">{g.label}</div>
              {g.rows.map(([when, text, pill]) => (
                <div class="mv-row">
                  <svg class="mv-chev" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
                  <span class="mv-when">{when}</span>
                  <span class="mv-text">{text}</span>
                  {pill && <span class={`pill ${pill[1] || ''}`}>{pill[0]}</span>}
                </div>
              ))}
            </>
          ))}
          <div class="mv-foot">24 facts · newest first</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .mem { display: grid; grid-template-columns: 1fr 1fr; gap: 112px; align-items: center; max-width: 1120px; }
  @media (max-width: 900px) { .mem { grid-template-columns: 1fr; gap: 32px; } }
  .mem-title { font-size: clamp(26px, 3.4vw, 36px); line-height: 1.12; font-weight: 600; letter-spacing: -0.03em; color: var(--fg-90); text-wrap: balance; }

  .mem-copy .lead { margin-top: 14px; max-width: 380px; }
  .mem-points { list-style: none; padding: 0; margin-top: 26px; display: flex; flex-direction: column; gap: 14px; }
  .mem-points li { font-size: 14px; line-height: 1.55; color: var(--mf-80); padding-left: 14px; border-left: 2px solid var(--border); }
  .mem-points li:last-child { border-left-color: var(--yellow); }
  .mem-points b { font-weight: 600; color: var(--fg-90); }

  /* The Memory screen in miniature (MemoryV4View.jsx). */
  .mv { width: 100%; max-width: 520px; justify-self: center; border-radius: 8px; border: 1px solid var(--hair); background: var(--background); overflow: hidden; box-shadow: 0 18px 44px -26px rgba(0,0,0,.16); }
  .mv-head { display: flex; align-items: center; gap: 9px; height: 48px; padding: 0 18px; }
  .mv-head svg { fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .mv-brain { width: 17px; height: 17px; color: color-mix(in oklab, var(--muted-foreground) 75%, transparent); }
  .mv-title { font-size: 15px; font-weight: 700; letter-spacing: -0.01em; }
  .mv-search { margin-left: auto; display: flex; align-items: center; gap: 6px; height: 28px; width: 180px; padding: 0 8px; border-radius: 6px; border: 1px solid color-mix(in oklab, var(--border) 55%, transparent); font-size: 12.5px; color: color-mix(in oklab, var(--muted-foreground) 60%, transparent); }
  .mv-search svg { width: 14px; height: 14px; }
  .mv-body { padding: 2px 18px 18px; display: flex; flex-direction: column; gap: 14px; }
  .mv-tabs { display: flex; gap: 22px; border-bottom: 1px solid color-mix(in oklab, var(--border) 50%, transparent); }
  .mv-tabs span { margin-bottom: -1px; padding-bottom: 10px; border-bottom: 2px solid transparent; font-size: 13px; font-weight: 500; color: color-mix(in oklab, var(--muted-foreground) 70%, transparent); white-space: nowrap; }
  .mv-tabs .on { border-bottom-color: var(--foreground); color: var(--foreground); }
  .mv-tabs i { font-style: normal; font-size: 11.5px; color: color-mix(in oklab, var(--muted-foreground) 55%, transparent); }
  .mv-filters { display: flex; gap: 10px; font-size: 12px; color: color-mix(in oklab, var(--muted-foreground) 65%, transparent); }
  .mv-filters b { font-weight: 500; color: var(--foreground); }
  .mv-list { border-radius: 6px; border: 1px solid var(--hair); background: var(--card); overflow: hidden; }
  .mv-group { padding: 5px 14px; border-bottom: 1px solid color-mix(in oklab, var(--border) 30%, transparent); background: color-mix(in oklab, var(--muted) 20%, transparent); font-size: 10.5px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: color-mix(in oklab, var(--muted-foreground) 60%, transparent); }
  .mv-row {
    display: flex; align-items: center; gap: 10px; padding: 8px 14px; border-bottom: 1px solid color-mix(in oklab, var(--border) 30%, transparent);
    opacity: 0; transform: translateY(4px); transition: opacity .4s ease, transform .4s ease;
  }
  .mv.in .mv-row { opacity: 1; transform: none; }
  .mv-row:nth-of-type(odd) { transition-delay: .12s; }
  .mv-chev { width: 14px; height: 14px; flex-shrink: 0; fill: none; stroke: color-mix(in oklab, var(--muted-foreground) 35%, transparent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .mv-when { width: 44px; flex-shrink: 0; font-size: 11.5px; font-variant-numeric: tabular-nums; color: color-mix(in oklab, var(--muted-foreground) 60%, transparent); }
  .mv-text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12.5px; color: var(--fg-85); }
  .mv-pills { display: flex; gap: 6px; flex-shrink: 0; }
  .pill { display: inline-flex; align-items: center; padding: 3px 6px; border-radius: 5px; font-size: 10.5px; font-weight: 500; line-height: 1; color: color-mix(in oklab, var(--muted-foreground) 80%, transparent); box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--foreground) 12%, transparent); }
  .pill.violet { background: rgb(139 92 246 / .07); color: #6d28d9; box-shadow: inset 0 0 0 1px rgb(139 92 246 / .25); }
  .pill.emerald { background: rgb(16 185 129 / .07); color: #047857; box-shadow: inset 0 0 0 1px rgb(16 185 129 / .25); }
  .mv-foot { padding: 10px 16px; text-align: center; font-size: 12px; color: color-mix(in oklab, var(--muted-foreground) 65%, transparent); }
  /* Phones: the card stripped to the facts, each readable in full. */
  @media (max-width: 620px) {
    .mv-search, .mv-tabs { display: none; }
    .mv-body { gap: 0; padding: 0 14px 14px; }
    .mv-row { display: grid; grid-template-columns: auto auto 1fr; column-gap: 10px; row-gap: 5px; align-items: center; padding: 11px 14px; }
    .mv-chev { grid-column: 1; grid-row: 1 / span 2; align-self: start; margin-top: 3px; }
    .mv-text { grid-column: 2 / -1; grid-row: 1; white-space: normal; overflow: visible; font-size: 13.5px; line-height: 1.45; }
    .mv-when { grid-column: 2; grid-row: 2; width: auto; font-size: 11px; }
    .mv-row .pill { grid-column: 3; grid-row: 2; justify-self: start; }
  }
</style>
