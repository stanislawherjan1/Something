---
// "GitHub | ★ n" for the repo. The count is read at build
// time so it is in the HTML, then refreshed in the browser; with no number
// (an offline build) the count is left empty.
// `big`: the hero's secondary button (quiet, 40 px) instead of the ghost one.
const { big = false } = Astro.props;
const REPO = 'https://github.com/stanislawherjan1/Something';
const REPO_API = 'https://api.github.com/repos/stanislawherjan1/Something';
let stars: number | null = null;
try {
  const r = await fetch(REPO_API, { headers: { Accept: 'application/vnd.github+json' } });
  if (r.ok) stars = (await r.json()).stargazers_count ?? null;
} catch {}
---
<a class:list={["stars", { big }]} href={REPO} data-api={REPO_API} target="_blank" rel="noopener">
  <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.71 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.66 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/></svg>
  <span class="gh-label">GitHub</span>
  <span class="count"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2.5 2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z"/></svg><b>{stars ?? ''}</b></span>
</a>

<script>
  // One request for every badge on the page; the build-time number stays if it fails.
  const badges = [...document.querySelectorAll<HTMLElement>('.stars')];
  const api = badges[0]?.dataset.api;
  if (api) {
    fetch(api).then((r) => (r.ok ? r.json() : null)).then((d) => {
      const n = d?.stargazers_count;
      if (typeof n === 'number') badges.forEach((b) => (b.querySelector('.count b')!.textContent = n.toLocaleString('en')));
    }).catch(() => {});
  }
</script>

<style>
  /* A ghost button next to the one solid CTA: same height, size and padding,
     no frame; the count sits after the name, quietly. */
  .stars {
    display: inline-flex; align-items: center; gap: 7px; height: 34px; padding: 0 12px; border-radius: 6px;
    font-size: 13px; font-weight: 500; color: var(--fg-85); transition: background .15s, color .15s;
  }
  .stars:hover { background: color-mix(in oklab, var(--foreground) 5%, transparent); color: var(--foreground); }
  .stars > svg { width: 15px; height: 15px; }
  .stars.big {
    height: 40px; padding: 0 14px 0 16px; gap: 8px; font-size: 14px; background: var(--card);
    border: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
  }
  .stars.big:hover { background: var(--card); border-color: color-mix(in oklab, var(--foreground) 30%, transparent); }
  .stars.big > svg { width: 16px; height: 16px; }
  .stars.big .count { font-size: 13px; }
  .count {
    display: inline-flex; align-items: center; gap: 4px; margin-left: 2px; padding-left: 9px;
    border-left: 1px solid color-mix(in oklab, var(--foreground) 12%, transparent);
    font-size: 12.5px; font-variant-numeric: tabular-nums; color: var(--muted-foreground);
  }
  .count b { font-weight: 500; }
  .count svg {
    width: 12px; height: 12px; fill: transparent; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round;
    transition: fill .2s, stroke .2s, rotate .3s;
  }
  .stars:hover .count svg { fill: var(--yellow); stroke: var(--yellow); rotate: 72deg; }
  @media (max-width: 560px) { .stars:not(.big) .gh-label { display: none; } .stars:not(.big) { padding: 0 10px; } }
</style>
