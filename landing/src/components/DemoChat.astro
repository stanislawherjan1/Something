---
// The workspace chat, replayed: tabs of roles above one chat window. Each tab
// plays a conversation the way the real panel shows it (ChatPanel.jsx /
// ToolChip.jsx): "Thinking", one live tool line that rolls over to the next
// tool, a "Used N tools" summary, then the reply streaming in.
//
// A switch above the window shows the same conversations where else the team
// talks to them: in Slack each role is a channel in the sidebar and the
// coworker answers as the app; in Telegram it's a chat with them, bubbles and
// "typing…" while they work. Same coworker, same work, only the place changes.

// Tool steps: [logo file | glyph name, label]. Logos are integration marks,
// glyphs stand for the built-in tools (same labels as TOOL_DISPLAY).
// `files` + `chat`: in Slack and Telegram a file the coworker wrote arrives as
// an attachment and the message no longer names it (as the bot does there);
// `chat` is the reply worded for that, `reply` the web panel's.
// `showcase`: the web tab plays this conversation in the real app — the demo
// build at /demo, ?showcase=<id> (frontend/src/demo/showcase.js) — not a copy.
const scenarios = [
  {
    role: 'Founder',
    showcase: 'founder',
    ask: 'What needs me today?',
    steps: [
      [
        ['gcalendar', 'Checking your calendar'],
        ['email', 'Reading your inbox'],
        ['@list', 'Checking the board'],
        ['@bell', 'Checking reminders'],
      ],
    ],
    reply: [
      'Three things need you today:',
      '<ol><li><b>10:00 investor call.</b> I put the numbers and last call’s open questions in <span class="file">investor-prep.md</span>.</li><li><b>A supplier invoice is 6 days overdue.</b> The reply is drafted, waiting for your yes.</li><li><b>Mara’s review is blocked</b> on your sign-off on the pricing page.</li></ol>',
      'Everything else is handled or scheduled.',
    ],
    files: [['investor-prep.md', '3 KB']],
    chat: [
      'Three things need you today:',
      '<ol><li><b>10:00 investor call.</b> The numbers and last call’s open questions are ready for it.</li><li><b>A supplier invoice is 6 days overdue.</b> The reply is drafted, waiting for your yes.</li><li><b>Mara’s review is blocked</b> on your sign-off on the pricing page.</li></ol>',
      'Everything else is handled or scheduled.',
    ],
  },
  {
    role: 'Store owner',
    showcase: 'shop',
    ask: 'Why did sales drop yesterday?',
    steps: [
      [
        ['shopify', 'List orders'],
        ['ga4', 'Run report'],
        ['meta', 'Get campaign insights'],
      ],
      [['shopify', 'Get shipping rules']],
    ],
    between: ['Traffic looks normal, so it isn’t the ads. Checking the checkout…'],
    reply: [
      'Traffic held. The checkout didn’t.',
      '<table><tr><th></th><th>Yesterday</th><th>Week avg</th></tr><tr><td>Sessions</td><td>4,812</td><td>4,950</td></tr><tr><td>Orders</td><td>142</td><td>198</td></tr><tr><td>Checkout conversion</td><td>1.9%</td><td>3.1%</td></tr></table>',
      'A shipping rule changed at 14:20: orders under €50 now pay €9 instead of free shipping. Drop-offs start exactly then. Want me to roll it back?',
    ],
  },
  {
    role: 'Sales',
    showcase: 'sales',
    ask: 'Follow up with everyone from Tuesday’s demo.',
    steps: [
      [
        ['gcalendar', 'Find event'],
        ['email', 'Search messages'],
        ['notion', 'Read call notes'],
      ],
      [['email', 'Create drafts'], ['@bell', 'Setting a reminder']],
    ],
    between: ['Got the attendee list and your notes from the call. Drafting the follow-ups…'],
    reply: [
      'Four people were on the demo. One already wrote back asking about pricing, so I attached the price sheet to her draft.',
      'The other <b>3 follow-ups are drafted</b> in your inbox, each one picking up on what they asked during the call.',
      'If anyone stays quiet, I’ll remind you on Friday.',
    ],
  },
  {
    role: 'Marketing',
    showcase: 'marketing',
    ask: 'Draft this week’s newsletter from what we shipped.',
    steps: [
      [
        ['@book', 'Using a skill'],
        ['@search', 'Searching files'],
        ['@file', 'Reading a file'],
        ['@edit', 'Writing a file'],
      ],
    ],
    reply: [
      'Draft saved to <span class="file">newsletter-w41.md</span>, in our usual voice. Three stories: the new bundle, the restock and a customer photo from Thursday.',
      'Subject line options:<ul><li>“Back in stock, and a new way to save”</li><li>“The mug set is back”</li></ul>',
      'I’ll schedule it once you approve.',
    ],
    files: [['newsletter-w41.md', '4 KB']],
    chat: [
      'The draft is ready, in our usual voice. Three stories: the new bundle, the restock and a customer photo from Thursday.',
      'Subject line options:<ul><li>“Back in stock, and a new way to save”</li><li>“The mug set is back”</li></ul>',
      'I’ll schedule it once you approve.',
    ],
  },
  {
    role: 'Team',
    showcase: 'team',
    ask: 'Remind the team about Friday’s inventory count.',
    steps: [
      [['@users', 'Checking the team']],
      [
        ['@bell', 'Setting a reminder'],
        ['@bell', 'Setting a reminder'],
        ['@bell', 'Setting a reminder'],
      ],
    ],
    between: ['Mara, Tom and Lena are on the count. Setting a reminder for each of them…'],
    reply: [
      'Done. Everyone gets a ping on Friday at 9:00: <b>Mara and Tom on Telegram</b>, <b>Lena in the workspace</b>, since that’s where each of them answers.',
      'I’ll collect the counts in <span class="file">Inventory.md</span> as they come in.',
    ],
    chat: [
      'Done. Everyone gets a ping on Friday at 9:00: <b>Mara and Tom on Telegram</b>, <b>Lena in the workspace</b>, since that’s where each of them answers.',
      'I’ll collect the counts as they come in.',
    ],
  },
];
// Slack: the company's own channels, one conversation each — not the roles.
const CHANNELS: Record<string, string> = { 'Founder': 'leadership', 'Store owner': 'shop', 'Marketing': 'marketing', 'Sales': 'wholesale', 'Team': 'studio' };
const channel = (role: string) => CHANNELS[role] || role.toLowerCase().replace(/\s+/g, '-');
// Telegram: a DM with the coworker and the company's groups, one conversation each.
const TG: Record<string, { name: string; color?: string; members?: number }> = {
  'Founder': { name: 'Aria' },
  'Store owner': { name: 'Shop', color: '#e17076', members: 4 },
  'Marketing': { name: 'Marketing', color: '#7bc862', members: 3 },
  'Sales': { name: 'Wholesale', color: '#65aadd', members: 5 },
  'Team': { name: 'Studio', color: '#ee7aae', members: 7 },
};
const tg = (role: string) => TG[role] || { name: role };
const SLACK_LOGO = '<svg viewBox="0 0 122.8 122.8"><path d="M25.8 77.6c0 7.1-5.8 12.9-12.9 12.9S0 84.7 0 77.6s5.8-12.9 12.9-12.9h12.9v12.9zm6.5 0c0-7.1 5.8-12.9 12.9-12.9s12.9 5.8 12.9 12.9v32.3c0 7.1-5.8 12.9-12.9 12.9s-12.9-5.8-12.9-12.9V77.6z" fill="#e01e5a"/><path d="M45.2 25.8c-7.1 0-12.9-5.8-12.9-12.9S38.1 0 45.2 0s12.9 5.8 12.9 12.9v12.9H45.2zm0 6.5c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9H12.9C5.8 58.1 0 52.3 0 45.2s5.8-12.9 12.9-12.9h32.3z" fill="#36c5f0"/><path d="M97 45.2c0-7.1 5.8-12.9 12.9-12.9s12.9 5.8 12.9 12.9-5.8 12.9-12.9 12.9H97V45.2zm-6.5 0c0 7.1-5.8 12.9-12.9 12.9s-12.9-5.8-12.9-12.9V12.9C64.7 5.8 70.5 0 77.6 0s12.9 5.8 12.9 12.9v32.3z" fill="#2eb67d"/><path d="M77.6 97c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9-12.9-5.8-12.9-12.9V97h12.9zm0-6.5c-7.1 0-12.9-5.8-12.9-12.9s5.8-12.9 12.9-12.9h32.3c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9H77.6z" fill="#ecb22e"/></svg>';
// The place switch wears each place's own mark: ours for the web app, Slack's and Telegram's in colour.
const surfaces = [
  { id: 'web', label: 'Web', logo: '<img src="/favicon.svg" alt="" />' },
  { id: 'slack', label: 'Slack', logo: SLACK_LOGO },
  { id: 'telegram', label: 'Telegram', logo: '<img src="/integrations/telegram.svg" alt="" />' },
];
const HASH = '<svg class="hash" viewBox="0 0 24 24"><path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"/></svg>';
const ARIA_PIC = { 'data-halftone': '', 'data-image': '/avatars/1.png', 'data-mode': 'dark', 'data-center': '', 'data-plain': '', 'data-paper': '', 'data-step': '1.7', 'data-scale': '1', 'data-seed': 'bot' };
import { svg } from '../lib/icons';
import '../styles/mocks.css';
---
<div class="demo" data-surface="web" data-scenarios={JSON.stringify(scenarios.map(s => ({ ...s, channel: channel(s.role), tg: tg(s.role) })))}>
  <div class="stage" data-halftone data-abstract="wave" data-seed="sign-in" data-soft data-amp="0.22">
    <div class="surfaces" role="tablist" aria-label="Where you talk to them">
      {surfaces.map((x, i) => (
        <button role="tab" class={`surf ${i === 0 ? 'on' : ''}`} aria-selected={i === 0 ? 'true' : 'false'} data-s={x.id}><span class="surf-logo" set:html={x.logo} />{x.label}</button>
      ))}
    </div>
  <div class="window">
    <div class="bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <div class="ws"><img src="/favicon.svg" alt="" /><b>Saltmarsh Ceramics</b></div>
      <div class="sec">Channels</div>
      <div class="tabs" role="tablist">
        {scenarios.map((s, i) => (
          <button role="tab" class={`tab ${i === 0 ? 'on' : ''}`} aria-selected={i === 0 ? 'true' : 'false'} data-i={i}><img class="t-fav" src="/favicon.svg" alt="" /><span class="t-role">{s.role}</span><span class="t-ch"><span set:html={HASH} />{channel(s.role)}</span></button>
        ))}
      </div>
      <div class="pick" aria-hidden="true">
        <button class="pick-btn prev" aria-label="Previous role"><svg viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg></button>
        <b class="pick-label">{scenarios[0].role}</b>
        <button class="pick-btn next" aria-label="Next role"><svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></button>
      </div>
    </div>
    <!-- Web: the app's own screens (captured from the demo build, public/mockups/app), under a browser's address bar. -->
    <div class="addr" aria-hidden="true"><span class="addr-field"><svg viewBox="0 0 24 24"><rect width="14" height="10" x="5" y="11" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><span>saltmarsh.something.md<b class="addr-path">/tasks</b></span></span></div>
    <div class="webapp">
      {scenarios.map((s, i) => <iframe class={`webapp-frame ${i === 0 ? 'on' : ''}`} data-id={s.showcase} src={`/mockups/app/${s.showcase}.html`} title="Something, the web app" tabindex="-1" aria-hidden="true" scrolling="no" inert></iframe>)}
    </div>
    <div class="main">
    <div class="chead" aria-hidden="true">
      <span class="ch-slack"><b><span set:html={HASH} /><span class="ch-name">{channel(scenarios[0].role)}</span></b><span class="here"><i></i>Aria is here</span></span>
    </div>
    <div class="list" aria-live="polite"><div class="list-inner"></div></div>
    <div class="composer" aria-hidden="true">
      <div class="field"><span class="ph">Ask anything</span><span class="typed"></span><span class="cursor"></span></div>
      <div class="composer-row">
        <span class="attach"><svg viewBox="0 0 24 24"><path d="m21 11-8.6 8.6a5.5 5.5 0 0 1-7.8-7.8l8.6-8.6a3.7 3.7 0 0 1 5.2 5.2l-8.6 8.6a1.8 1.8 0 0 1-2.6-2.6l7.9-7.9"/></svg>Attach</span>
        <span class="send"><svg viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7"/></svg></span>
      </div>
    </div>
    </div>
  </div>

  <!-- Telegram: two phones, the same phone as in "Wherever you already talk" (mocks.css):
       the chat list on the left, the open chat on the right. -->
  <div class="phones">
    <div class="mk"><div class="phone">
      <div class="tg-status"><b>9:41</b><span class="island"></span><span class="tg-batt"></span></div>
      <div class="tgl-head"><span>Edit</span><b>Chats</b><span class="tgl-new" set:html={svg('plus')} /></div>
      <div class="tgl-search"><span set:html={svg('search')} />Search</div>
      <div class="tgl-list">
        {scenarios.map((s, i) => (
          <button class={`tgl-item ${i === 0 ? 'on' : ''}`} data-i={i}>
            {tg(s.role).color ? <span class="tgl-av" style={`--c:${tg(s.role).color}`}>{tg(s.role).name[0]}</span> : <span class="tgl-av bot" {...ARIA_PIC}></span>}
            <span class="tgl-text"><b>{tg(s.role).name}</b><span>{s.ask}</span></span>
            <time>9:41</time>
          </button>
        ))}
      </div>
    </div></div>
    <div class="mk"><div class="phone">
      <div class="tg-status"><b>9:41</b><span class="island"></span><span class="tg-batt"></span></div>
      <div class="tg-head">
        <span class="tg-back" set:html={svg('back') + '<i>Chats</i>'} />
        <span class="tg-who"><b class="tgc-name">Aria</b><span class="tgc-sub">bot</span></span>
        <span class="tg-av"><span class="tgc-bot bot" {...ARIA_PIC}></span><span class="tgc-grp"></span></span>
      </div>
      <div class="tg-wall tgc-wall"></div>
      <div class="tg-input">
        <span set:html={svg('tgclip', 'tg-i')} />
        <span class="tg-field">Message<span set:html={svg('smile', 'tg-i sm')} /></span>
        <span set:html={svg('mic', 'tg-i')} />
      </div>
    </div></div>
  </div>
  </div>
</div>

<script>
  type Step = [string, string];
  type Scenario = { role: string; channel: string; tg: { name: string; color?: string; members?: number }; ask: string; steps: Step[][]; between?: string[]; reply: string[]; chat?: string[]; files?: [string, string][]; showcase: string };
  type Surface = 'web' | 'slack' | 'telegram';
  import { mountHalftones } from '../scripts/halftone.js';

  const DOC = '<svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>';
  // "You" in Slack wears Slack's default picture: a person on a coloured tile.
  const YOU = '<svg viewBox="0 0 36 36"><circle cx="18" cy="14" r="6.5" fill="#fff"/><path d="M5 36c1.5-8 7-12 13-12s11.5 4 13 12z" fill="#fff"/></svg>';
  const ARIA = 'data-halftone data-image="/avatars/1.png" data-mode="dark" data-center data-plain data-paper data-step="1.7" data-scale="1" data-seed="bot"';


  // A chat app has no tables: Telegram gets the table as plain lines.
  const asLines = (block: string) => {
    if (!block.startsWith('<table')) return block;
    const t = document.createElement('div');
    t.innerHTML = block;
    const head = [...t.querySelectorAll('th')].map((x) => x.textContent || '');
    return [...t.querySelectorAll('tr')].slice(1).map((tr) => {
      const c = [...tr.querySelectorAll('td')].map((x) => x.textContent || '');
      return `<b>${c[0]}</b>: ${c[1]} (${(head[2] || '').toLowerCase()} ${c[2]})`;
    }).join('<br>');
  };

  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const demo of document.querySelectorAll<HTMLElement>('.demo')) {
    const scenarios: Scenario[] = JSON.parse(demo.dataset.scenarios || '[]');
    const list = demo.querySelector<HTMLElement>('.list')!;
    const inner = demo.querySelector<HTMLElement>('.list-inner')!;
    const tabs = [...demo.querySelectorAll<HTMLButtonElement>('.tab')];
    const composer = demo.querySelector<HTMLElement>('.composer')!;
    const pickLabel = demo.querySelector<HTMLElement>('.pick-label')!;
    const typed = demo.querySelector<HTMLElement>('.typed')!;
    const send = demo.querySelector<HTMLElement>('.send')!;
    const surfs = [...demo.querySelectorAll<HTMLButtonElement>('.surf')];
    const ph = demo.querySelector<HTMLElement>('.ph')!;
    const chName = demo.querySelector<HTMLElement>('.ch-name')!;
    // Telegram's phones.
    const chats = [...demo.querySelectorAll<HTMLButtonElement>('.tgl-item')];
    const wall = demo.querySelector<HTMLElement>('.tgc-wall')!;
    const tgName = demo.querySelector<HTMLElement>('.tgc-name')!;
    const tgSub = demo.querySelector<HTMLElement>('.tgc-sub')!;
    const tgAv = demo.querySelector<HTMLElement>('.phones .tg-av')!;
    const tgGrp = demo.querySelector<HTMLElement>('.tgc-grp')!;
    // Web: one captured screen of the app per conversation, all loaded with the
    // page, so switching only shows another; each plays its chat on 'showcase:play'.
    const frames = [...demo.querySelectorAll<HTMLIFrameElement>('.webapp-frame')];
    const addrPath = demo.querySelector<HTMLElement>('.addr-path')!;
    const OPENS_AT_END = new Set(['marketing']);
    const ROUTES: Record<string, string> = { founder: '/tasks', shop: '/', marketing: '/files/Marketing/newsletter-this-week.md', sales: '/files/Wholesale/cafe-demo-plan.md', team: '/team' };
    // On a phone the desktop app would be too small to read: it is laid out at
    // desktop width and only its chat panel (the right 460px) is shown, fitted.
    const webBox = demo.querySelector<HTMLElement>('.webapp')!;
    const DESK = 1000, CHAT = 460;
    new ResizeObserver(() => {
      const w = webBox.clientWidth, h = webBox.clientHeight;
      if (!w) return;   // hidden (another surface): keep the last size
      const k = w < 720 ? w / CHAT : 1;
      for (const f of frames) {
        f.style.width = k === 1 ? '100%' : `${DESK}px`;
        f.style.height = `${h / k}px`;
        f.style.transform = k === 1 ? '' : `scale(${k}) translateX(${CHAT - DESK}px)`;
      }
    }).observe(webBox);
    // Telegram on a phone: the open chat, scaled to the stage's own width with
    // room at its sides. A fixed zoom left the phone's frame on the stage's
    // edges at 375px, and iOS Safari, which sizes zoomed boxes its own way,
    // cut it off; a measured transform scales alike everywhere.
    const stageEl = demo.querySelector<HTMLElement>('.stage')!;
    new ResizeObserver(() => {
      const cs = getComputedStyle(stageEl);
      const inner = stageEl.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      if (inner > 0) demo.style.setProperty('--tgk', String(Math.min(0.84, Math.max(0.5, (inner - 24) / 390))));
    }).observe(stageEl);
    // A screen is ready once loaded (it may finish before this script runs).
    const frameReady = new Map(frames.map((f) => [f, new Promise<void>((r) => {
      const ok = () => { f.classList.add('ready'); r(); };
      if (f.contentDocument?.readyState === 'complete' && f.contentDocument.body?.dataset.ask !== undefined) ok();
      else f.addEventListener('load', ok, { once: true });
    })]));
    let frameDone: (() => void) | null = null;
    window.addEventListener('message', (e) => {
      const f = frames.find((x) => x.contentWindow === e.source);
      if (!f?.classList.contains('on')) return;
      if (e.data?.type === 'showcase:opened') addrPath.textContent = ROUTES[f.dataset.id!] || '';
      if (e.data?.type === 'showcase:done') frameDone?.();
    });
    let run = 0;          // bumped on every switch, so a stale replay stops
    let current = 0;
    let userPicked = false;
    let surface: Surface = 'web';

    const add = (html: string, cls: string, into: HTMLElement = inner) => {
      const el = document.createElement('div');
      el.className = cls;
      el.innerHTML = html;
      into.appendChild(el);
      if (into === inner) list.scrollTop = list.scrollHeight;
      return el;
    };

    // How long the coworker takes before a message lands where it just arrives whole.
    const work = (s: Scenario, g: number) => (reduced ? 0 : 900 + 650 * (s.steps[g]?.length || 1));

    async function typeAsk(ask: string, alive: () => boolean) {
      await sleep(reduced ? 0 : 500); if (!alive()) return false;
      composer.classList.add('typing');
      for (let k = 1; k <= ask.length; k++) {
        typed.textContent = ask.slice(0, k);
        if (!reduced) await sleep(ask[k - 1] === ' ' ? 55 : 32);
        if (!alive()) return false;
      }
      send.classList.add('on');
      await sleep(reduced ? 0 : 420); if (!alive()) return false;
      send.classList.add('press');
      await sleep(140); if (!alive()) return false;
      send.classList.remove('on', 'press');
      composer.classList.remove('typing');
      typed.textContent = '';
      return true;
    }

    // ── Web: the real app plays it, from the composer to the reply.
    async function playWeb(s: Scenario, alive: () => boolean) {
      const frame = frames.find((f) => f.dataset.id === s.showcase)!;
      frames.forEach((f) => f.classList.toggle('on', f === frame));
      // A file the reply writes is opened at its end (the 'showcase:opened' message).
      addrPath.textContent = OPENS_AT_END.has(s.showcase) ? '' : (ROUTES[s.showcase] || '/').replace(/^\/$/, '');
      await frameReady.get(frame); if (!alive()) return false;
      const done = new Promise<void>((r) => { frameDone = r; setTimeout(r, 30_000); });
      frame.contentWindow?.postMessage({ type: 'showcase:play' }, '*');
      await done;
      return alive();
    }

    // ── Slack: no "thinking", no tools — the app's messages simply arrive, whole.
    async function playSlack(s: Scenario, alive: () => boolean) {
      if (!(await typeAsk(`@Aria ${s.ask}`, alive))) return false;
      add(`<span class="s-av s-you">${YOU}</span><div class="s-body"><p class="s-who"><b>You</b><time>9:41 AM</time></p><p><span class="s-at">@Aria</span> ${s.ask}</p></div>`, 'row-user s-msg');
      let body: HTMLElement | null = null;
      const say = (html: string) => {
        if (!body) {
          const row = add(`<span class="s-av bot" ${ARIA}></span><div class="s-body"><p class="s-who"><b>Aria</b><em class="s-app">APP</em><time>9:42 AM</time></p></div>`, 'row-bot s-msg');
          mountHalftones(row);
          body = row.querySelector<HTMLElement>('.s-body')!;
        }
        const el = document.createElement('div');
        el.className = 'para land';
        el.innerHTML = html;
        body.appendChild(el);
        list.scrollTop = list.scrollHeight;
      };
      for (let g = 0; g < s.steps.length; g++) {
        await sleep(work(s, g)); if (!alive()) return false;
        const said = s.between?.[g];
        if (said) say(said);
      }
      // The file it wrote is attached to the message, not named in it.
      const reply = s.chat || s.reply;
      for (const block of reply) say(block);   // each paragraph its own block, landing together
      for (const [name, size] of s.files || []) say(`<div class="s-file"><span class="s-file-ic">${DOC}</span><span><b>${name}</b><span>Markdown · ${size}</span></span></div>`);
      return true;
    }

    // ── Telegram: the phone shows "typing…" while they work; each message lands whole.
    async function playTelegram(s: Scenario, alive: () => boolean) {
      const group = !!s.tg.color;
      const idle = group ? `${s.tg.members} members` : 'bot';
      await sleep(reduced ? 0 : 700); if (!alive()) return false;
      add(`<span class="tg-date">Today</span>`, 'tgc-day', wall);
      add(`${s.ask}<span class="tg-meta">9:41 <i>✓✓</i></span>`, 'tg-msg out', wall);
      tgSub.textContent = group ? 'Aria is typing…' : 'typing…';
      tgSub.classList.add('busy');
      // Back-to-back messages from the coworker, as Telegram groups them: the
      // name only over the first, the picture only beside the last.
      let prev: HTMLElement | null = null;
      const say = (html: string) => {
        const follows = !!prev && prev === wall.lastElementChild;
        const msg = `<div class="tg-msg in">${group && !follows ? '<b class="tg-name aria">Aria</b>' : ''}${html}<span class="tg-meta">9:42</span></div>`;
        const row = add(group ? `<span class="tg-pava bot" ${ARIA}></span>${msg}` : msg, group ? 'tg-row' : 'tg-solo', wall);
        if (group) {
          if (follows) prev!.querySelector<HTMLElement>('.tg-pava')!.style.visibility = 'hidden';
          mountHalftones(row);
        }
        prev = row;
      };
      for (let g = 0; g < s.steps.length; g++) {
        await sleep(work(s, g)); if (!alive()) return false;
        const said = s.between?.[g];
        if (said) say(said);
      }
      // The message, which doesn't name the file; the file it wrote follows it as a document.
      say((s.chat || s.reply).map(asLines).map((b) => `<div class="para">${b}</div>`).join(''));
      for (const [name, size] of s.files || []) {
        await sleep(reduced ? 0 : 450); if (!alive()) return false;
        say(`<div class="tg-doc"><span class="tg-doc-ic">${DOC}</span><span><b>${name}</b><span>${size}</span></span></div>`);
      }
      tgSub.textContent = idle;
      tgSub.classList.remove('busy');
      return true;
    }

    async function play(i: number) {
      const me = ++run;
      const alive = () => me === run;
      const s = scenarios[i];
      current = i;
      tabs.forEach((t, k) => { t.classList.toggle('on', k === i); t.setAttribute('aria-selected', String(k === i)); });
      chats.forEach((c, k) => c.classList.toggle('on', k === i));
      pickLabel.textContent = surface === 'slack' ? `#${s.channel}` : s.role;
      chName.textContent = s.channel;
      ph.textContent = surface === 'slack' ? `Message #${s.channel}` : 'Ask anything';
      inner.innerHTML = '';
      wall.innerHTML = '';
      typed.textContent = '';
      composer.classList.remove('typing');
      send.classList.remove('on', 'press');
      // The open chat's header: a DM wears the coworker's face, a group its initial.
      const group = !!s.tg.color;
      tgName.textContent = s.tg.name;
      tgSub.textContent = group ? `${s.tg.members} members` : 'bot';
      tgSub.classList.remove('busy');
      tgAv.classList.toggle('group', group);
      tgGrp.textContent = s.tg.name[0];
      tgGrp.style.setProperty('--c', s.tg.color || '');

      const done = await (surface === 'slack' ? playSlack(s, alive) : surface === 'telegram' ? playTelegram(s, alive) : playWeb(s, alive));
      if (!done) return;

      // Then on to the next conversation, unless the visitor took over.
      if (userPicked) return;
      await sleep(5200); if (!alive() || userPicked) return;
      play((current + 1) % scenarios.length);
    }

    tabs.forEach((t) => t.addEventListener('click', () => { userPicked = true; play(Number(t.dataset.i)); }));
    chats.forEach((c) => c.addEventListener('click', () => { userPicked = true; play(Number(c.dataset.i)); }));
    // The place switch replays the same conversation there.
    surfs.forEach((b) => b.addEventListener('click', () => {
      surface = b.dataset.s as Surface;
      demo.dataset.surface = surface;
      surfs.forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-selected', String(x === b)); });
      play(current);
    }));
    // Phones: the same choice as the tabs, one at a time with arrows.
    const step = (d: number) => { userPicked = true; play((current + d + scenarios.length) % scenarios.length); };
    demo.querySelector('.pick-btn.prev')!.addEventListener('click', () => step(-1));
    demo.querySelector('.pick-btn.next')!.addEventListener('click', () => step(1));

    // Start when the demo scrolls into view.
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { io.disconnect(); play(0); }
    }, { threshold: 0.35 });
    io.observe(demo);
  }
</script>

