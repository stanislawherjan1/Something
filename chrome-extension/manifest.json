{
  "manifest_version": 3,
  "name": "Something",
  "description": "Your workspace chat next to any page.",
  "version": "0.3.0",
  "key": "",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Something",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "identity",
    "cookies",
    "tabs",
    "activeTab",
    "scripting",
    "contextMenus",
    "debugger"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
