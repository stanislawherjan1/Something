# =============================================================================
# clients/admin.env — shared operator secrets used across ALL clients
# =============================================================================
# Copy this file to `admin.env` (gitignored) and fill in real values:
#
#   cp clients/admin.env.example clients/admin.env
#   chmod 600 clients/admin.env
#
# Loaded automatically by:
#   - ide-template/deploy.sh        (every per-client deploy)
#   - bin/add-redirect-uri.sh       (adding a new client domain to OAuth)
#
# Per-client `.env` values WIN over these — legacy clients with their own
# GOOGLE_CLIENT_ID/SECRET keep working unchanged until you migrate them.
#
# To use a different path (e.g. ~/.workspace-admin/master.env for sync across
# machines), set WORKSPACE_ADMIN_ENV before running deploy.sh.
# =============================================================================

# --- Shared Google OAuth app -------------------------------------------------
# One OAuth 2.0 Client ID covers every client. Onboarding a new client =
# adding their `https://<domain>/auth/callback` to this app's authorised
# redirect URI list (use `bin/add-redirect-uri.sh <domain>` for that).
#
# Setup (one-time, in https://console.cloud.google.com):
#   1. APIs & Services → Credentials → Create OAuth 2.0 Client ID
#      Type: Web application, name: "Workspace (shared)"
#   2. OAuth consent screen → Publishing status: Production
#      (otherwise only listed test users can sign in)
#   3. Bulk-add redirect URIs for every existing client domain
#
# PROJECT_ID + OAUTH_CLIENT_ID are used by the redirect-uri helper to call
# the Google API. CLIENT_ID + CLIENT_SECRET are used by auth-service for the
# actual OAuth flow.

GOOGLE_OAUTH_PROJECT_ID=workspace-shared-XXXX
GOOGLE_OAUTH_CLIENT_ID=YYYY.apps.googleusercontent.com
GOOGLE_CLIENT_ID=YYYY.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# --- Optional: restic backup creds (Phase 6) ---------------------------------
# Used by ide-template/scripts/restic-backup.sh on the server. Only relevant
# if you ship the backup cron — otherwise leave commented out.
#
# RESTIC_REPOSITORY=b2:workspace-backups:/<ide-name>
# RESTIC_PASSWORD=<long random>
# B2_ACCOUNT_ID=<keyID>
# B2_ACCOUNT_KEY=<applicationKey>
