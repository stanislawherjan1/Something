# =============================================================================
# Per-client .env — minimal config for a new deployment
# =============================================================================
# Fill in these THREE fields. Everything else is auto-derived (IDE_NAME from
# folder name, REMOTE_PATH, ALLOWED_ORIGINS, …) or auto-generated (cryptographic
# random for SESSION_SECRET + CODE_SERVER_PASSWORD) on the first deploy.
#
# `bin/bootstrap-client-env.sh` (called by every client wrapper before deploy)
# writes the derived values back to this file once. Re-runs are idempotent —
# secrets aren't rotated, your edits aren't overwritten.
#
# Branding (workspace title, bot name, avatar, backstory, personality) is set
# by the end-user through the in-browser wizard on first login. Don't put it
# here — that defeats the wizard. See docs/INTEGRATIONS.md for the encrypted
# credential model used by all MCP integrations (Telegram, Shopify, Meta, …).
#
# Shared OAuth credentials (GOOGLE_CLIENT_ID/SECRET) live in `clients/admin.env`
# and are forwarded to the remote .env automatically by deploy.sh.
# =============================================================================

# 1. Where to deploy
HETZNER_HOST=root@YOUR_SERVER_IP

# 2. Public domain (DNS A record points here)
FRONTEND_DOMAIN=client.example.com

# 3. Comma-separated emails allowed to log in
#    First email becomes admin (bootstrap into .allowed-emails.json),
#    rest become members. Manage from Sidebar → Team after first login.
IDE_ALLOWED_EMAILS=primary@example.com

# =============================================================================
# Optional overrides (leave blank to use the default)
# =============================================================================
# LEGACY_DRIVE_SYNC=true   — enable rclone Drive sync (pre-2026-05 clients only)
# LEGACY_CONFIG=true       — branding read-only via UI; managed via .env + redeploy
#                            and overrides/public/. Leave off for new clients.

# =============================================================================
# DO NOT EDIT BELOW — fields written here by bin/bootstrap-client-env.sh on
# first deploy:
#   IDE_NAME, REMOTE_PATH, SESSION_COOKIE_NAME, ALLOWED_ORIGINS  (derived)
#   BOT_NAME, VITE_APP_TITLE, VITE_*, LEGACY_DRIVE_SYNC, LEGACY_CONFIG  (defaults)
#   SESSION_SECRET, CODE_SERVER_PASSWORD                          (random)
# =============================================================================
